# Firebase
FIREBASE_PROJECT_ID=toem-here
FIREBASE_API_KEY=your_api_key_here

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# App Config
APP_ENV=development  # development | staging | production
