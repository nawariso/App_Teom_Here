rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ─── Monitors ───
    match /monitors/{monitorId} {
      // Anyone can read monitors
      allow read: if true;

      // Only authenticated users can create
      allow create: if isAuthenticated();

      // Only allow updating votes and lastSeen fields
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['votes', 'lastSeenAt', 'lastSeenBy', 'latitude',
                       'longitude', 'photoGallery', 'sightingStreak']);

      allow delete: if false;

      // Voters subcollection
      match /voters/{userId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAuthenticated() && isOwner(userId);
      }
    }

    // ─── Sightings ───
    match /sightings/{sightingId} {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if false;
    }
  }
}
